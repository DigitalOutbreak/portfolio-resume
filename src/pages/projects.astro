---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---
<BaseLayout
  title="Software Projects | Rust, TypeScript & Web | Joey Alvarado"
  description="Software projects and case studies covering Rust backend systems, Axum APIs, TypeScript, browser extensions, Next.js, Astro, and client web development."
>
  <section class="page-hero">
    <p class="eyebrow">Selected work</p>
    <h1>Projects I can explain and stand behind.</h1>
    <p>A mix of public code, developer tools, and client work built around real problems.</p>
  </section>
  <section class="section">
    <div class="projects">
      {projects.map((project, index) => (
        <article class="project">
          <div class="project-meta"><span>{project.number}</span><span>{project.type}</span></div>
          <div class="project-body">
            {project.image && (
              <a class="project-preview" href={`/projects/${project.slug}`} aria-label={`Read the ${project.name} case study`}>
                <img
                  src={project.image}
                  alt={project.imageAlt ?? ''}
                  width={project.imageWidth ?? 1200}
                  height={project.imageHeight ?? 675}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
              </a>
            )}
            <p class="project-kicker">{project.name}</p>
            <h2>{project.title}</h2>
            <p>{project.summary}</p>
            <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            <a class="project-link" href={`/projects/${project.slug}`}>Read case study <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
