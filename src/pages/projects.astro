---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="Projects | Joey Alvarado" description="Public software projects and client work by Joey Alvarado.">
  <section class="page-hero">
    <p class="eyebrow">Selected work</p>
    <h1>Projects I can explain and stand behind.</h1>
    <p>A mix of public code, developer tools, and client work built around real problems.</p>
  </section>
  <section class="section">
    <div class="projects">
      {projects.map((project) => (
        <article class="project">
          <div class="project-meta"><span>{project.number}</span><span>{project.type}</span></div>
          <div class="project-body">
            <p class="project-kicker">{project.name}</p>
            <h2>{project.title}</h2>
            <p>{project.summary}</p>
            <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            <a class="project-link" href={`/projects/${project.slug}`}>Read case study <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
