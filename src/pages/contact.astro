---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Joey Alvarado | Software Developer"
  description="Contact Chicago-area software developer Joey Alvarado about Rust, backend, TypeScript, web development, and software engineering opportunities."
>
  <section class="contact">
    <p class="eyebrow">Get in touch</p>
    <h1>I'm open to software development opportunities.</h1>
    <p>The easiest way to reach me is by email or LinkedIn. You can also find me on X, and my public code is on GitHub.</p>
    <div class="actions">
      <a class="button button-primary" href="mailto:joeynalvarado@gmail.com">Email me</a>
      <a class="button" href="https://www.linkedin.com/in/joeyalvarado" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="button" href="/joey-alvarado-resume.pdf" download>Download résumé</a>
      <a class="text-link" href="https://github.com/DigitalOutbreak" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="https://x.com/joeynalvarado" target="_blank" rel="noreferrer">X <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
