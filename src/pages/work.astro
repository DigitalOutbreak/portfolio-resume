---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Work | Joey Alvarado" description="Web development, project delivery, and freelance software work by Joey Alvarado.">
  <section class="page-hero">
    <p class="eyebrow">Work</p>
    <h1>Web development, internal tools, and project delivery.</h1>
    <p>My experience comes from shipping work for real businesses and owning the details between the first request and the final launch.</p>
  </section>
  <section class="section work-history">
    <article class="work-entry">
      <div class="work-meta">
        <p>May 2025 – Present</p>
        <p>Freelance · Remote</p>
      </div>
      <div>
        <h2>Freelance Web Developer</h2>
        <p class="work-company">Digital Outbreak</p>
        <p>I build websites and internal tools for small businesses. Most of my work has been client websites, but I have also built dashboards and a CRM to help manage leads and day-to-day operations.</p>
        <p>I handle projects from the first conversation through launch, including design, development, revisions, and ongoing fixes.</p>
      </div>
    </article>
    <article class="work-entry">
      <div class="work-meta">
        <p>Sep 2022 – May 2025</p>
        <p>Chicago area</p>
      </div>
      <div>
        <h2>Web Developer &amp; Project Manager</h2>
        <p class="work-company">SEOLEVELUP</p>
        <p>Built and maintained responsive marketing websites and landing pages for business clients using WordPress, Webflow, Framer, and custom CSS.</p>
        <p>Worked from Figma mockups, managed projects from requirements through launch, and used Python for small internal tools and workflow experiments.</p>
      </div>
    </article>
  </section>
  <section class="section">
    <a class="button button-primary" href="/projects">View projects</a>
  </section>
</BaseLayout>
