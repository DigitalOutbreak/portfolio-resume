---
import BaseLayout from '../../layouts/BaseLayout.astro';
const notes = [
  { label: 'Rust', title: "What I'm learning in Rust right now", description: 'Why I am keeping the projects small while I work through ownership, errors, and testing.', href: '/blog/rust-fundamentals' },
  { label: 'Projects', title: 'What I actually look for in a portfolio project', description: 'A useful problem, a scope I understand, and enough verification to trust the result.', href: '/blog/project-proof' },
  { label: 'Career', title: 'How client websites led me to internal tools', description: 'The path from building pages to caring more about the systems behind the business.', href: '/blog/systems-direction' },
];
---
<BaseLayout title="Notes | Joey Alvarado" description="Notes from Joey Alvarado about software projects, Rust, and backend development.">
  <section class="page-hero">
    <p class="eyebrow">Notes</p>
    <h1>Things I'm learning by building.</h1>
    <p>Short notes on projects, Rust, and the move from client websites toward backend systems.</p>
  </section>
  <section class="section">
    <div class="notes">
      {notes.map((note) => (
        <article class="note">
          <p class="note-meta">{note.label}</p>
          <h2>{note.title}</h2>
          <p>{note.description}</p>
          <a href={note.href}>Read note <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
