---
import BaseLayout from '../../layouts/BaseLayout.astro';
const notes = [
  { label: 'Browser extensions', title: 'Adding local destinations to a web clipper', description: 'The browser constraints behind folder, Downloads, and Clipboard output.', href: '/blog/local-web-clipper-destinations' },
  { label: 'Local-first', title: 'Why CramForge keeps books and study material local', description: 'How the EPUB import and Markdown study-pack workflow avoids bundled books and provider lock-in.', href: '/blog/cramforge-local-first' },
  { label: 'Client work', title: 'How client websites led me to internal tools', description: 'The point where forms, leads, dashboards, and CRM workflows became part of the same problem.', href: '/blog/systems-direction' },
];
---
<BaseLayout title="Notes | Joey Alvarado" description="Notes from Joey Alvarado about software projects, Rust, and backend development.">
  <section class="page-hero">
    <p class="eyebrow">Notes</p>
    <h1>Notes from the work.</h1>
    <p>Short explanations of project constraints, implementation decisions, and what I check before calling something done.</p>
  </section>
  <section class="section">
    <div class="notes">
      {notes.map((note) => (
        <article class="note">
          <p class="note-meta">{note.label}</p>
          <h2>{note.title}</h2>
          <p>{note.description}</p>
          <a href={note.href}>Read note <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
